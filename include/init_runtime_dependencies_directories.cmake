set(RUNTIME_DEPENDENCIES_DIRECTORIES "")
get_filename_component(_compiler_dir "${CMAKE_CXX_COMPILER}" DIRECTORY)
if(EXISTS "${_compiler_dir}")
  list(APPEND RUNTIME_DEPENDENCIES_DIRECTORIES "${_compiler_dir}")
endif()
if(EXISTS "${VCPKG_INSTALLED_DIR}/${VCPKG_TARGET_TRIPLET}/bin")
  list(APPEND RUNTIME_DEPENDENCIES_DIRECTORIES "${VCPKG_INSTALLED_DIR}/${VCPKG_TARGET_TRIPLET}/bin")
endif()
if(EXISTS "${VCPKG_INSTALLED_DIR}/${VCPKG_TARGET_TRIPLET}/lib")
  list(APPEND RUNTIME_DEPENDENCIES_DIRECTORIES "${VCPKG_INSTALLED_DIR}/${VCPKG_TARGET_TRIPLET}/lib")
endif()
if(EXISTS "/usr/local/bin")
  list(APPEND RUNTIME_DEPENDENCIES_DIRECTORIES "/usr/local/bin")
endif()
list(REMOVE_DUPLICATES RUNTIME_DEPENDENCIES_DIRECTORIES)
message(STATUS "RUNTIME_DEPENDENCIES_DIRECTORIES: ${RUNTIME_DEPENDENCIES_DIRECTORIES}")
